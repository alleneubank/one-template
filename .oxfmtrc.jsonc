{
  // Oxfmt configuration (Prettier-compatible)
  // Docs: https://oxc.rs/docs/guide/usage/formatter
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  // Generated declarations (One typegen) are rewritten by their generator.
  // mise writes the npm tools' lock sidecars and checks their digests.
  "ignorePatterns": ["**/*.d.ts", "**/*.d.*.ts", "**/.one-native-source.json", ".mise/**"],
}
